# Base URL of the FloPay API. Baked in at build time by Vite, so changing it
# requires a redeploy — it is not read at runtime.
#
# Local development (default when unset):
#   VITE_API_BASE_URL=http://localhost:8080
#
# Production — your Render service URL, no trailing slash:
VITE_API_BASE_URL=https://flopay-api.onrender.com
