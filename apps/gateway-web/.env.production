# Production API base URL, inlined by Vite at build time.
#
# Matches the service name in ../render.yaml (flopay-api). If you deploy the
# backend under a different name, change this and redeploy the frontend — a
# restart is not enough, because the value is baked into the bundle.
VITE_API_BASE_URL=https://flopay-api.onrender.com
