# Production API base URL, inlined by Vite at build time.
#
# Same backend as gateway-web (../gateway-web/.env.production) — one
# gateway-api service serves both the merchant dashboard and the wallet app.
# A restart is not enough if this changes — it's baked into the bundle, so
# the frontend needs a rebuild + redeploy.
VITE_API_BASE_URL=https://flopay-api.onrender.com
